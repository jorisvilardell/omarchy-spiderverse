#!/bin/bash

set -euo pipefail

CONFIG_NAME="spiderverse-launcher"
CONFIG_PATH="$HOME/.config/quickshell/$CONFIG_NAME/shell.qml"

is_running() {
  qs list --all 2>/dev/null | grep -Fq "Config path: $CONFIG_PATH"
}

wait_until_running() {
  for _ in {1..30}; do
    is_running && return 0
    sleep 0.1
  done
  return 1
}

wait_until_stopped() {
  for _ in {1..30}; do
    is_running || return 0
    sleep 0.1
  done
  return 1
}

start_shell() {
  is_running && return 0
  setsid qs -n -d -c "$CONFIG_NAME" >/dev/null 2>&1 < /dev/null &
  wait_until_running
  # Being listed only means the process exists -- give its IpcHandler a beat
  # to come up before anything tries to talk to it (send_ipc below retries
  # too, but this avoids relying on that alone for a fresh cold start).
  sleep 0.3
}

# Being listed by `qs list` only means the process exists -- its IpcHandler
# can still take a moment to come up on a cold start, which was silently
# swallowing the very first toggle right after launch. Retry briefly instead
# of firing once and giving up.
send_ipc() {
  for _ in {1..20}; do
    qs -c "$CONFIG_NAME" ipc call command "$1" 2>/dev/null && return 0
    sleep 0.1
  done
  return 1
}

stop_shell() {
  is_running || return 0
  qs kill -c "$CONFIG_NAME" >/dev/null
  wait_until_stopped
}

case "${1:-status}" in
  start)
    start_shell
    ;;
  stop)
    stop_shell
    ;;
  restart)
    stop_shell
    start_shell
    ;;
  toggle)
    # Hot path: the shell is almost always already running, so try the IPC
    # call directly first -- skips the `qs list` round trip that start_shell's
    # is_running check would otherwise spend on every single toggle. Only
    # fall back to the full start+retry path if that first attempt fails
    # (i.e. the shell genuinely isn't up yet).
    qs -c "$CONFIG_NAME" ipc call command toggle 2>/dev/null || {
      start_shell
      send_ipc toggle
    }
    ;;
  close)
    is_running && send_ipc close
    ;;
  status)
    if is_running; then
      echo "Spiderverse launcher is running"
    else
      echo "Spiderverse launcher is stopped"
      exit 1
    fi
    ;;
  log)
    exec qs log -c "$CONFIG_NAME"
    ;;
  *)
    echo "Usage: omarchy-spiderverse-launcher {start|stop|restart|toggle|close|status|log}" >&2
    exit 2
    ;;
esac
